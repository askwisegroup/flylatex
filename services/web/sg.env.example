# =============================================================================
# 海外站（sg）部署环境变量示例
#
# 本文件是**sg 分支独有**的部署参考（master 上没有）。
# 所有差异都通过 env 表达，不改业务代码 —— 详见 docs/sg-deployment.md。
#
# 用法：
#   cp sg.env.example sg.env && 填入真实值
#   （sg.env 含密钥，不要提交；本文件只放占位符）
# =============================================================================

# --- 部署档位 ---------------------------------------------------------------
# 决定 loginProviders / billing / llm 的**默认值**；下面各项仍可逐项覆盖。
DEPLOYMENT_PROFILE=sg
DEPLOYMENT_REGION=SG

# --- 站点 -------------------------------------------------------------------
PUBLIC_URL=https://www.flylatex.sg
SITE_URL=https://www.flylatex.sg

# --- 登录 -------------------------------------------------------------------
# 海外站：Google 为主，NE 密码 / 短信 / CARSI 全关（档位默认已如此，此处显式写出）
LOGIN_GOOGLE=1
LOGIN_PASSWORD=0
LOGIN_SMS=0
LOGIN_CARSI=0

# Google Cloud Console → API 和服务 → 凭据 → OAuth 2.0 客户端 ID（Web 应用）
# 已获授权的 JavaScript 来源必须逐字符包含 PUBLIC_URL
GOOGLE_CLIENT_ID=
GOOGLE_REQUIRE_VERIFIED_EMAIL=1
# 可选：限制只能某些域登录，逗号分隔，留空=不限制
GOOGLE_ALLOWED_DOMAINS=
# nonce 存储：多实例必须用 redis（默认）；单实例本地开发可设 memory
GOOGLE_NONCE_STORE=redis

# --- 设置页 -----------------------------------------------------------------
# 设置页「修改密码」入口默认下线（Google/统一认证登录，邮件通道未开通，
# 改密与重置邮件的闭环是断的）。置 1 恢复原入口，代码一行没删。
PASSWORD_CHANGE_ENABLED=0

# --- 计费 -------------------------------------------------------------------
BILLING_ENABLED=1
BILLING_PROVIDER=none
BILLING_CURRENCY=SGD
# 注册赠送额度，单位：微单位（1 SGD = 1_000_000 micro）
BILLING_SIGNUP_GRANT_MICROS=5000000

# 汇率：USD → 结算币种。不配置时按 1 记账并在账本里留下 fx_rate=1。
BILLING_FX_USD_TO_SGD=1.35

# 设置页「充值」按钮的跳转地址（支付渠道自己的收银台 / 账户充值页）。
# 留空 = 按钮为禁用态，只提示「通道开通中，请联系客服」，不会把用户送进 404。
BILLING_TOPUP_URL=


# --- LLM 上游（按协议，不按厂商） -------------------------------------------
# chat_completions 或 responses
LLM_PROTOCOL=chat_completions
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-chat
LLM_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner
LLM_TIMEOUT_MS=600000

# --- 文献检索 ---------------------------------------------------------------
# 海外站不用 NE 令牌驱动的 crosrefsearch，先用 AMiner
CROSSREF_SEARCH_DISABLED=1
AMINER_ENABLED=1

# 对外品牌名。默认值是 `FlyLaTeX (Fork from Overleaf Community Edition)`，
# 那个括号是给内部溯源用的，不能出现在客户界面（标题/邮件/欢迎语都用它）。
APP_NAME=FlyLaTeX
