extends ../layout

block vars
  - var projectId = locals.project_id

block content
  .ai-chat-panel
    position: fixed
    bottom: 0
    left: 0
    right: 0
    width: 100%
    height: 350px
    background-color: #fff
    border-top: 2px solid #2c3645
    z-index: 10000
  
  .ai-chat-header
    padding: 12px 16px
    background-color: #2c3645
    color: #fff
    display: flex
    justify-content: space-between
    align-items: center
  
  .ai-chat-title
    font-weight: 600
    font-size: 16px
  
  .ai-chat-header
    padding: 12px  Chat Panel - Angular 版本
    background-color: #2c3645
    color: #fff
    display: flex
    justify-content: space-between
    align-items: center
  
  .ai-chat-header-left
    display: flex
    align-items: center
    gap: 8px
  
  // AI 助手图标
  i.ai-bot(style="font-size: 24px;")
    | AI
  
  span.ai-chat-title=translate('ai_assistant')
  
  .ai-chat-header-right
    display: flex
    gap: 12px
    align-items: center
  
  button.btn-link
    background: transparent
    border: none
    font-size: 20px
    color: #c9d1d9
    cursor: pointer
    padding: 8px
    transition: color 0.2s ease
  
    button.btn-link:hover
    color: #fff
    gap: 8px
  
  .ai-chat-header-right
    display: flex
    gap: 12px
    align-items: center
  
  .ai-chat-close
    background: transparent
    border: none
    font-size: 20px
    color: #c9d1d9
    cursor: pointer
  
  .ai-chat-messages
  flex: 1
  overflow-y: auto
  padding: 12px
  background-color: #f8f9fa
  height: calc(100% - 80px)
  text-align: center
  
  .ai-chat-welcome
    color: #666
    font-size: 14px
    line-height: 1.6
  
  .ai-message
    margin-bottom: 12px
    padding: 10px 14px
    border-radius: 12px
    background-color: #e8eaf6
    color: #333
  
  .ai-message-user
    text-align: right
  
  .ai-message-assistant
    text-align: left
  
  .ai-message-avatar
    width: 24px
    height: 24px
    border-radius: 50%
    display: flex
    align-items: center
    justify-content: center
    margin-right: 8px
    color: #fff
  
  .ai-message-assistant .ai-message-avatar
    background-color: #4caf50
  
  .ai-message-user .ai-message-avatar
    background-color: #1565c0
  
  .ai-chat-message
    margin-bottom: 12px
    padding: 10px 14px
    border-radius: 12px
    background-color: #e8eaf6
    color: #333
  
  .ai-message-user
    text-align: right
  
  .ai-message-assistant
    text-align: left
  
  .ai-message-avatar
    width: 24px
    height: 24px
    border-radius: 50%
    display: flex
    align-items: center
    justify-content: center
    margin-right: 8px
    color: #fff
  
  .ai-message-assistant .ai-message-avatar
    background-color: #4caf50
  
  .ai-message-user .ai-message-avatar
    background-color: #1565c0
  
  .ai-chat-input-area
    padding: 12px
    background-color: #f8f9fa
    border-top: 1px solid #e0e0e0
  
  textarea
    width: 100%
    min-height: 80px
    max-height: 200px
    padding: 8px 12px
    border: 1px solid #ddd
    border-radius: 8px
    resize: vertical
    font-family: inherit
    font-size: 14px
    outline: none
  
  textarea:focus
    border-color: #2c3645
