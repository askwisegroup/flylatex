extends ../layout-marketing

block content
	main.content.content-alt#main-content
		.help-page
			h1 帮助中心
			p.help-sub 编译超时、常见 LaTeX 报错，以及编辑器里几个功能的用法。

			nav.help-toc
				strong 目录
				ol
					li: a(href="#help-timeout") 编译超时
					li: a(href="#help-errors") 常见编译错误速查
					li: a(href="#help-images") 插入图片
					li: a(href="#help-floats") 图表位置（浮动体）
					li: a(href="#help-tables") 表格与对齐
					li: a(href="#help-crossrefs") 标签与交叉引用
					li: a(href="#help-preamble") 导言区
					li: a(href="#help-packages") 宏包
					li: a(href="#help-pdf") PDF 预览与加载
					li: a(href="#help-account") 账号与邮箱
					li: a(href="#help-sync") 同步与导入
					li: a(href="#help-history") 历史记录
					li: a(href="#help-archive") 归档与回收站
					li: a(href="#help-editor") 编辑器
					li: a(href="#help-sharing") 分享与协作
					li: a(href="#help-sso") 机构账号登录

			.help-body
				section#help-timeout
					h2 编译超时
					p 每次编译都有时长上限，超过上限会被强制中止，本次编译不会生成 PDF。上限取决于你的账户类型，编译超时的提示里会写出具体是几分钟。
					h3 常见原因
					ol
						li
							strong 图片太大或分辨率太高。
							|  扫描件、手机照片、几百 MB 的 TIFF 是头号原因。A4 页面上的插图，150–300 dpi 已经足够印刷。
						li
							strong 计算量大的宏包。
							|  TikZ/PGFPlots 画的复杂图形、大型表格（几百行）、大量数学公式，都会显著拉长编译时间。
						li
							strong 致命错误让编译器反复重试。
							|  有些错误会让 LaTeX 一遍遍重跑而无法收敛，这时日志里往往停在同一个位置。先修错误，编译时间通常立刻恢复正常。
						li
							strong 参考文献、索引、目录要跑多遍。
							|  BibTeX/biber、makeindex、大型文档的交叉引用，每遍都要时间，文档越大越明显。
					h3 怎么排查
					ul
						li 打开编译菜单里的
							strong 「首次错误即停止」
							| ，先让真正的第一个错误暴露出来。
						li 把最近新增的章节、图片、宏包注释掉再编译，用二分法定位。
						li 看日志最后一屏：真卡在某一步时，最后一行通常就是元凶。
					h3 怎么缩短编译时间
					ul
						li 图片先压缩（PSNR 之外，直接把 3000 万像素的扫描件降到 2000 像素宽），或在导言区用
							code \usepackage[draft]{graphicx}
							|  让图片只占位不渲染。
						li 拆分为多个
							code \include
							|  的子文件，用
							code \includeonly
							|  只编译正在写的那一章。
						li 去掉用不到的宏包；能换轻量方案的就换（比如用
							code booktabs
							|  的简单表格代替复杂嵌套）。
						li 需要更快时可以临时关掉语法检查，但不要长期关。

				section#help-errors
					h2 常见编译错误速查
					p 下面是日志里最常出现的提示。日志面板会把常见错误翻译成人话，这里给出完整对照。
					table.help-table
						thead
							tr
								th 错误提示
								th 原因
								th 怎么修
						tbody
							tr
								td: code Undefined control sequence
								td 用了未定义或拼错的命令，或者宏包没加载
								td 检查拼写；确认命令来自的宏包已经
									code \usepackage
									| 。命令名区分大小写。
							tr
								td: code Missing $ inserted
								td 在数学环境外写了数学符号（下划线、上标、希腊字母等）
								td 把内容放进
									code $...$
									| 或
									code \[...\]
									| ；文本里的下划线要写成
									code \_
									| 。
							tr
								td: code Display math should end with $$
								td 行间公式的
									code $$
									| 没配对
								td 检查每处公式的
									code $$
									| 数量；建议改用
									code \[...\]
									| 更不容易出错。
							tr
								td: code Double superscript / Double subscript
								td 同一个对象上写了两个上标或两个下标
								td 例如
									code x^2^3
									| 要写成
									code x^{2^3}
									| 或
									code {x^2}^3
									| 。
							tr
								td: code Missing \right inserted / Extra \right
								td
									code \left(
									| 与
									code \right)
									| 不配对
								td 逐对检查；跨行时用
									code \right.
									| 与
									code \left.
									| 占位。
							tr
								td: code Environment XXX undefined
								td 环境不存在，或提供它的宏包没加载，或写成
									code \begin{...}
									| 后又拼错了环境名
								td 例如
									code align
									| 需要
									code amsmath
									| ；
									code tabularx
									| 需要
									code tabularx
									| 宏包。
							tr
								td: code File XXX not found on input line XXX
								td 找不到被引用的文件：图片、子文件或宏包文件
								td 确认文件名与扩展名大小写一致；确认文件在项目里，路径不含空格和中文。
							tr
								td: code Unknown graphics extension
								td 用了当前引擎不支持的图片格式
								td pdfLaTeX 支持 PDF/PNG/JPG；EPS 需要先转换，或改用 XeLaTeX/LuaLaTeX 并加
									code \usepackage{epstopdf}
									| 。
							tr
								td: code Unknown float option
								td
									code [H]
									| 之类的定位参数需要
									code float
									| 宏包
								td 在导言区加
									code \usepackage{float}
									| ，或改用标准参数
									code [htbp]
									| 。
							tr
								td: code '!h' float specifier changed to '!ht'
								td 只是提醒：LaTeX 把
									code !h
									| 放宽成了
									code !ht
								td 不影响结果。想要严格原位，用
									code [H]
									| （需
									code float
									| 宏包）。
							tr
								td: code There's no line here to end
								td 段落开头或空行处写了
									code \\
								td 删掉多余的换行；需要额外间距用
									code \vspace
									| 或
									code \bigskip
									| 。
							tr
								td: code Something's wrong--perhaps a missing \item
								td 列表环境里缺
									code \item
									| ，或者把非列表内容塞进了
									code itemize/enumerate
								td 给每一项加上
									code \item
									| ；列表里不要直接放段落。
							tr
								td: code \verb ended by end of line
								td
									code \verb
									| 的定界符没有在同一行内配对
								td 让
									code \verb|...|
									| 完整写在一行里；需要多行原样文本用
									code verbatim
									| 环境。
							tr
								td: code \mathrm allowed only in math mode
								td 数学命令写在了正文里
								td 把
									code \mathrm{...}
									| 放进数学环境，或改用
									code \textrm{...}
									| 。
							tr
								td: code Illegal unit of measure (pt inserted)
								td 长度后面漏了单位
								td 写成
									code 2cm
									| 、
									code 10pt
									| 这样的完整长度；纯数字是非法长度。
							tr
								td: code No \author given
								td
									code \maketitle
									| 之前没有
									code \author
								td 补上
									code \author{...}
									| （可以留空
									code \author{}
									| ）。
							tr
								td: code No positions in optional float specifier
								td 方括号里没写定位字母
								td 写成
									code [htbp]
									| ，不要写空的
									code []
									| 。
							tr
								td: code Misplaced alignment tab character &
								td
									code &
									| 出现在对齐环境外面
								td 在对齐环境（
									code tabular
									| 、
									code align
									| ）里使用；正文里要显示
									code &
									| 请写
									code \&
									| 。
							tr
								td: code Extra alignment tab has been changed to \cr
								td 一行的
									code &
									| 比列格式声明的列数多
								td 让每行的
									code &
									| 数量与
									code \begin{tabular}{...}
									| 里声明的列数一致。
							tr
								td: code Misplaced \noalign
								td 通常在
									code tabular
									| 与前面的
									code \hline
									| 之间多了空行
								td 去掉空行，让
									code \hline
									| 紧贴
									code \begin{tabular}
									| 和表格行。
							tr
								td: code Can be used only in preamble
								td 只能出现在导言区的命令放到了正文里
								td 把
									code \usepackage
									| 等命令移到
									code \begin{document}
									| 之前。
							tr
								td: code Missing \begin{document}
								td 导言区里有可直接输出的内容，或缺少
									code \begin{document}
								td 确认导言区只有宏包与定义；确认
									code \begin{document}
									| 只出现一次且拼写正确。
							tr
								td: code There were undefined references
								td 有
									code \ref
									| 找不到对应的
									code \label
									| ，或还没编译足够遍数
								td 再编译一到两遍；确认
									code \label
									| 写在
									code \caption
									| 之后、且不在会被移动的位置。
							tr
								td: code There were multiply-defined labels
								td 同一个
									code \label
									| 名用了两次
								td 给每个标签唯一的名字；从旧章节复制内容后特别容易撞名。
							tr
								td: code Citation XXX undefined
								td
									code \cite
									| 引用的键在 .bib 里不存在，或 BibTeX 还没跑
								td 核对
									code \bibliography
									| 指向的文件与键名；重新编译让 BibTeX 生效。

					h3 排查思路（通用）
					ol
						li 从日志的第一个错误看起，后面的报错常常是第一个引起的连锁反应。
						li 二分法：注释掉一半内容再编译，能编译就说明问题在另一半。
						li 报错行号是「编译器当前所在行」，不一定等于真正写错的行；往往是它前一两行少了个括号。
						li 括号、环境
							code \begin
							| /
							code \end
							| 成对性，是最高频的两类问题。

				section#help-images
					h2 插入图片
					pre
						code.
							\usepackage{graphicx}
							...
							\begin{figure}[htbp]
							  \centering
							  \includegraphics[width=0.8\textwidth]{figures/plot.pdf}
							  \caption{示例图}
							  \label{fig:plot}
							\end{figure}
					ul
						li 文件名只用英文、数字、下划线、连字符：空格、中文、括号、`#` 都可能让编译器找不到文件。
						li 路径可以用
							code \graphicspath{{figures/}}
							|  统一指定，之后直接写文件名。
						li 图片不要超出页面：
							code width=\textwidth
							|  或
							code width=\linewidth
							|  让它自适应。
						li 中文排版（XeLaTeX +
							code ctex
							| ）时，图片标题里的中文不需要额外处理，但
							code \caption
							| 里的
							code \label
							| 顺序不能颠倒。

				section#help-floats
					h2 图表位置（浮动体）
					p LaTeX 默认把 figure/table 当“浮动体”，自己挑位置放。用方括号里的字母表达偏好：
					table.help-table
						thead
							tr
								th 参数
								th 含义
						tbody
							tr
								td: code h
								td 尽量放在此处（here）
							tr
								td: code t
								td 页面顶部（top）
							tr
								td: code b
								td 页面底部（bottom）
							tr
								td: code p
								td 单独一页（page）
							tr
								td: code H
								td 严格放在此处，不浮动（需
									code float
									| 宏包）
							tr
								td: code !
								td 放宽内部约束，例如
									code [htbp!]
					ul
						li 写了
							code [h]
							|  但排不下时，LaTeX 会把它改成
							code [ht]
							|  并给出提示，这不是错误。
						li 图总是跑到文末：通常是浮动体太多、页面约束太紧，加
							code !
							|  或改用
							code [H]
							| 。
						li 想让文字环绕图片，用
							code wrapfig
							|  宏包，但它在跨页时容易出问题。

				section#help-tables
					h2 表格与对齐
					pre
						code.
							\begin{table}[htbp]
							  \centering
							  \begin{tabular}{lcr}
							    \hline
							    名称 & 数量 & 单价 \\
							    \hline
							    A & 10 & 3.5 \\
							    B & 20 & 4.0 \\
							    \hline
							  \end{tabular}
							  \caption{示例表}
							  \label{tab:demo}
							\end{table}
					ul
						li 列格式里的字母个数 = 每行
							code &
							|  的个数 + 1。多一个少一个都会报对齐错误。
						li
							code l
							| /
							code c
							| /
							code r
							|  是左/中/右对齐，
							code p{3cm}
							|  是定宽自动换行。
						li 合并单元格用
							code \multirow
							|  与
							code \multicolumn
							| （分别需要同名宏包）。
						li 三线表用
							code booktabs
							|  的
							code \toprule
							| /
							code \midrule
							| /
							code \bottomrule
							| ，比
							code \hline
							|  好看得多。

				section#help-crossrefs
					h2 标签与交叉引用
					ul
						li
							code \label{fig:a}
							|  写在
							code \caption
							|  之后，这样引用到的是图号而不是章节号。
						li 引用用
							code \ref{fig:a}
							| 、公式用
							code \eqref{eq:a}
							| 、页码用
							code \pageref{fig:a}
							| 。
						li 交叉引用必须编译两遍以上才稳定：第一遍收集，第二遍写入。
						li 日志显示
							code ??
							|  或 undefined references，通常就是遍数不够或标签名写错。

				section#help-preamble
					h2 导言区
					p 从
						code \documentclass
						|  到
						code \begin{document}
						|  之间的部分叫导言区，只能放文档类、宏包和全局设置。
					pre
						code.
							\documentclass[12pt]{article}
							\usepackage{ctex}
							\usepackage{graphicx}
							\title{标题}
							\author{作者}
							\begin{document}
							\maketitle
							正文……
							\end{document}
					ul
						li 正文内容放进导言区会报
							code Can be used only in preamble
							| 。
						li
							code \begin{document}
							|  只能出现一次，重复或多写会报
							code Missing \begin{document}
							|  之类的连锁错误。

				section#help-packages
					h2 宏包
					ul
						li 用
							code \usepackage{宏包名}
							|  加载；同一个宏包只写一次。
						li 顺序有时会冲突：一般先加载
							code ctex
							| / 编码相关，再加载数学与绘图宏包。
						li 中文文档推荐
							code ctex
							| ，并选用 XeLaTeX 编译；用 pdfLaTeX + ctex 虽然也能跑，但字体与特殊字符支持较弱。
						li 报
							code Undefined control sequence
							|  时，先确认这个命令属于哪个宏包、有没有加载。

				section#help-pdf
					h2 PDF 预览与加载
					h3 编译成功但右侧没有 PDF
					ul
						li 先看日志面板有没有错误；日志只显示到某个
							code Output written on ...
							|  之前，通常意味着编译中途退出了。
						li 刷新一下页面（强制刷新更彻底），有时是浏览器缓存了旧的预览。
						li 清理缓存后重新编译：日志面板底部的「清除缓存文件」会清掉中间产物，下一遍重新生成。
						li 浏览器插件（广告拦截、隐私扩展）偶尔会拦截 PDF 渲染，试试无痕窗口。
					h3 PDF 一直显示加载中
					ul
						li 文档特别大（几百页、上千张图）时，浏览器渲染需要时间；先等一会，不要反复点编译。
						li 内存不足的旧电脑上，长文档更容易卡住；可以先只渲染其中一章。
					h3 正向/反向搜索（SyncTeX）
					ul
						li 在源码里点击定位到 PDF，或在 PDF 里双击跳回源码。
						li 跳不动通常是中间产物
							code .synctex.gz
							|  没生成：确认编译参数里没有关掉 SyncTeX，并清理缓存重编一遍。

				section#help-account
					h2 账号与邮箱
					ul
						li 设置页可以添加多个邮箱，任意一个都能用来登录与找回密码。
						li 机构邮箱需要先完成确认才能用于机构身份；没确认时会反复提示重新验证。
						li 机构账号与个人账号是两套身份，项目不互通；需要时请用分享功能转移项目。
						li 管理员为你开通的账号（托管账号）由所属单位统一管理，改密码、改邮箱需要联系管理员。

				section#help-sync
					h2 同步与导入
					h3 从 Git 仓库导入项目
					ul
						li 仓库地址要能从服务器访问；私有仓库需要把访问令牌写进地址或使用可匿名克隆的链接。
						li 仓库太大、或者网络很慢时，导入会超时。可以先把仓库精简（去掉历史大文件）再导入。
						li 导入完成后，之后的更新需要在本地操作，编辑器不会自动拉取。
					h3 Dropbox 同步
					ul
						li 同步不是实时的：改动会在几十秒内分批同步，冲突时以最后一次写入为准。
						li 同步出错时先断开再重新连接；仍不行就检查 Dropbox 授权是否被撤销。
						li 图片、PDF 等大文件同步更慢，写作过程中不要频繁在两个端改同一个文件。

				section#help-history
					h2 历史记录
					p 编辑器左侧的「历史」会按时间保存每次修改的版本。选中任意两个版本可以比较差异，也可以把整份文档回退到某个版本。
					ul
						li 版本按时间线排列，标注了作者与修改内容。
						li 回退会生成一个新的版本，不会丢失之后的历史。
						li 多人协作时，历史里能看清谁改了什么，便于交接与排查。

				section#help-archive
					h2 归档与回收站
					ul
						li 「归档」把项目从项目列表里收起来，但不删除，随时可以恢复。
						li 「删除」会先移到回收站，回收站里的项目可以还原。
						li 归档与回收站都只是整理手段，不会影响项目的分享链接与协作者。

				section#help-editor
					h2 编辑器
					ul
						li 主编辑区支持语法高亮、自动补全、括号匹配与实时错误提示。
						li 左侧文件树可以新建、重命名、上传文件；上传的图片放在同名目录下最稳妥。
						li 编译产出的 PDF 在右侧预览，支持正向/反向搜索（SyncTeX）：点源码跳到 PDF，点 PDF 跳回源码。
						li 编译日志在右侧「日志」面板，出现错误时会自动展开。
						li
							strong 提示编辑器与项目不同步
							| （out of sync）时，说明本地缓存和服务器上的文件对不上：先按提示刷新/重新加载；仍不行就复制未保存的内容到本地，然后刷新页面。
						li 左侧的文件大纲会随章节、图表、标签自动生成，长文档里用它跳转比搜索快。

				section#help-sharing
					h2 分享与协作
					ul
						li 邀请协作者时区分「可编辑」和「只读」，只读成员不能改动内容，但可以下载和编译。
						li 链接分享（Link sharing）会给项目生成一个可访问链接，权限可以在「只读」和「可编辑」之间随时切换，也可以随时关闭。
						li 协作者改动会实时出现在编辑器里，不需要刷新；光标位置用不同颜色区分。
						li 多人同时改同一个段落容易互相覆盖，建议按章节分工，或先用历史记录找出被覆盖的版本。
						li 把项目分享给另一个账号不会复制内容；需要完整副本，请用「复制项目」。

				section#help-sso
					h2 机构账号登录
					p 如果你的学校或单位已接入统一身份认证（CARSI / SAML / Shibboleth），登录页会显示对应的机构入口，用机构账号登录即可，不需要单独注册。
					ul
						li 找不到自己的机构：先确认登录页的机构列表里有没有，或联系所在单位的图书馆/信息中心。
						li 机构账号与个人账号是两套身份，项目不互通；如果需要迁移，请把项目分享给另一个账号再复制。

	script(type="text/javascript", nonce=scriptNonce).
		(function () {
			var links = document.querySelectorAll('.help-toc a[href^="#"]');
			if (!links.length || !('IntersectionObserver' in window)) return;
			var map = {};
			Array.prototype.forEach.call(links, function (a) {
				map[a.getAttribute('href').slice(1)] = a;
			});
			var current = null;
			var observer = new IntersectionObserver(function (entries) {
				var visible = entries.filter(function (e) { return e.isIntersecting; });
				if (!visible.length) return;
				visible.sort(function (a, b) {
					return a.boundingClientRect.top - b.boundingClientRect.top;
				});
				var link = map[visible[0].target.id];
				if (!link || link === current) return;
				if (current) current.classList.remove('is-active');
				link.classList.add('is-active');
				current = link;
			}, { rootMargin: '-12% 0px -72% 0px' });
			Object.keys(map).forEach(function (id) {
				var el = document.getElementById(id);
				if (el) observer.observe(el);
			});
		})();
