//- ---------------------------------------------------------------------------
//- 站点功能菜单（顶部导航里「白板 / 论文模板 / TikZ 模板」那一排）
//-
//- 数据来自 MongoDB（sharelatex.nav_menus / _id=portal），由运营后台 carsi-mgr
//- 的「导航菜单」页维护，渲染逻辑见 app/src/Features/Navigation/PortalMenu.js。
//- 这里只负责「拿结构画 Bootstrap 2 的 navbar」，不要在模板里写业务判断。
//-
//- 每个节点只有三种 kind：
//-   item      → <li><a ...>，用 label / link / target / class / event
//-   group     → <li class="dropdown">，忽略 link/target，用 children
//-   separator → <li class="divider">，忽略其它所有字段
//- label 是 { "语言码": "显示文案" }，取词规则见 PortalMenu.resolveLabel
//- （精确匹配 → 同基础语言 → 站点默认语言 → en → 第一个非空）。
//-
//- 用法：include 之后 +portalMenuList(portalMenu.forUser)
//- ---------------------------------------------------------------------------

//- 单项链接：target=_blank 时补 rel=noopener noreferrer（防新页反向改主窗口）
mixin portalMenuItemLink(item)
	- var linkTarget = item.target || undefined
	a(
		href=item.link
		target=linkTarget
		rel=(linkTarget === '_blank' ? 'noopener noreferrer' : undefined)
		class=(item.class || undefined)
		event-tracking=(item.event || undefined)
		event-tracking-trigger=(item.event ? 'click' : undefined)
	)= portalMenuLabel(item.label)

//- 递归渲染一层列表。depth 只用来对付写坏的数据：
//- Bootstrap 2 的 dropdown 不支持多级子菜单，所以第 2 层起退化成
//- 「分组标题 + 平铺子项」—— 信息不丢，样式也不会崩。
mixin portalMenuEntries(items, depth)
	each entry in (items || [])
		if entry.kind === 'separator'
			li.divider(role="separator")
		else if entry.kind === 'group' && depth === 0
			li.dropdown(class=(entry.class || undefined))
				a.dropdown-toggle(
					href="#"
					role="button"
					aria-haspopup="true"
					aria-expanded="false"
					data-toggle="dropdown"
				)
					span= portalMenuLabel(entry.label)
					span.caret
				ul.dropdown-menu
					+portalMenuEntries(entry.children, depth + 1)
		else if entry.kind === 'group'
			li.dropdown-header= portalMenuLabel(entry.label)
			+portalMenuEntries(entry.children, depth + 1)
		else
			li(class=(entry.class || undefined))
				+portalMenuItemLink(entry)

//- 入口：传 PortalMenu.splitByVisibility() 得到的数组（forGuest / forUser）
mixin portalMenuList(items)
	+portalMenuEntries(items, 0)
